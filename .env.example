# Copy to .env (docker compose reads it). Everything is optional for a local run.

# Model provider: "simulated" (default, no key, no spend) or "anthropic".
LLM_PROVIDER=simulated
ANTHROPIC_API_KEY=

# Trace destinations beyond the bundled Phoenix. Pick an overlay:
#   overlay.none.yaml (Phoenix only), overlay.langsmith.yaml, overlay.arize.yaml, overlay.all.yaml
OTEL_OVERLAY=overlay.none.yaml
PROJECT_NAME=production-agent
LANGSMITH_API_KEY=
# EU region: https://eu.api.smith.langchain.com/otel
LANGSMITH_OTLP_ENDPOINT=https://api.smith.langchain.com/otel
ARIZE_SPACE_ID=
ARIZE_API_KEY=

# Keep this share of successful traces (errors and slow traces are always kept).
TRACE_SAMPLE_PERCENT=100
# Export prompts, answers and tool I/O on spans.
TRACE_CAPTURE_CONTENT=true

GRAFANA_ADMIN_PASSWORD=admin
