# v1.5.0 - prompt v2 ("be thorough, re-check whenever not completely certain").
# This is the bad release used in the rollback drill: on real traffic a prompt
# like this makes the model re-verify the same order/policy repeatedly and write
# longer answers. With LLM_PROVIDER=simulated that behaviour is reproduced by the
# SIM_* fault-injection settings below; with LLM_PROVIDER=anthropic they are ignored
# and the prompt itself is what is being tested.
PROMPT_VERSION=v2
MODEL=claude-opus-5-5
EFFORT=medium
MAX_STEPS=8
MAX_IDENTICAL_TOOL_CALLS=3
MAX_REQUEST_COST_USD=0.50

SIM_LOOP_RATE=0.15
SIM_VERBOSITY=2.5
SIM_LATENCY_MULTIPLIER=1.3
